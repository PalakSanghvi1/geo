# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets (this is a public repo)
.env*
!.env.example

# local database + any run artifacts
/data/
*.db
*.db-wal
*.db-shm

# pm2
.pm2/
logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The demo script is deliberately local-only. It names what is fabricated, what is
# untested and what not to say on camera — useful to the team, not something to ship
# in a public repo or onto the server.
docs/demo-script.md
