# Copy to .env and fill in. NEVER commit .env — this is a public repo.

# --- LLM providers (Workstream A) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Slack (Workstream C) — Socket Mode, no public URL needed ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# --- Notion (Workstream C) — internal integration ---
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Linear (Workstream C) — personal API key ---
LINEAR_API_KEY=

# --- Runtime ---
DATABASE_PATH=./data/geo.db
PORT=3100

# Public base URL used in Slack/Notion links back to the dashboard
PUBLIC_BASE_URL=http://5.78.222.163/GEO

# If > 0, the worker also kicks off a run every N minutes (demo mode).
DEMO_CADENCE_MINUTES=0

# Number of simulated past days for scripts/backfill.ts
BACKFILL_DAYS=7
